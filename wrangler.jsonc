{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "classmoney",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classmoney",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "classmoney",
      "binding": "R2",
      "remote": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
