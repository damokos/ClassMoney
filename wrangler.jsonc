{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "classmoney",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "classmoney",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "classmoney",
      "binding": "R2",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
	"env": {
	  "masodik": {
	    "name": "classmoney-v2",
	    "d1_databases": [
	      {
		"binding": "DB",
		"database_name": "classmoney-v2",
		"database_id": "IDE_AZ_UJ_D1_DATABASE_ID",
		"remote": true
	      }
	    ],
	    "r2_buckets": [
	      {
		"binding": "R2",
		"bucket_name": "classmoney-v2",
		"remote": true
	      }
	    ],
	    "triggers": {
	      "crons": ["*/5 * * * *"]
	    }
	  }
	}
}
